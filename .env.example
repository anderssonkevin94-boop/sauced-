# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both unset to run in demo mode (in-memory sample data, no login).

# Optional: turns on "Tidy up" on the recipe form (Claude sorts a pasted recipe or photo into the usual format).
# From console.anthropic.com → API Keys. Server-only: never prefix it with NEXT_PUBLIC_. Leave unset to hide the feature.
ANTHROPIC_API_KEY=
